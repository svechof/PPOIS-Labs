# Конфигурация Doxygen для документации API лабораторной работы.
DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "Lab 1 — C++17"
PROJECT_BRIEF          = "Крестики-нолики и многочлены"
OUTPUT_LANGUAGE = Russian
OUTPUT_DIRECTORY       = lab1/docs
INPUT                  = lab1/include lab1/cli README.md
FILE_PATTERNS          = *.h *.cpp *.md
RECURSIVE              = YES
EXCLUDE                = lab1/build lab1/build-* lab1/.deps lab1/tests
EXCLUDE_PATTERNS       = */build/* */.deps/*
USE_MDFILE_AS_MAINPAGE = README.md
MARKDOWN_SUPPORT       = YES
GENERATE_HTML           = YES
HTML_OUTPUT             = html
GENERATE_LATEX          = NO
EXTRACT_ALL             = NO
EXTRACT_PRIVATE         = NO
EXTRACT_STATIC          = NO
WARN_IF_UNDOCUMENTED    = YES
WARN_NO_PARAMDOC        = NO
WARN_AS_ERROR           = YES
WARN_FORMAT             = "$file:$line: $text"
QUIET                   = NO
WARNINGS                = YES
WARN_IF_DOC_ERROR       = YES
WARN_IF_INCOMPLETE_DOC  = YES
FULL_PATH_NAMES         = YES
STRIP_FROM_PATH         = lab1/include lab1/cli
ENABLE_PREPROCESSING    = YES
MACRO_EXPANSION         = NO
SORT_MEMBER_DOCS        = YES
SOURCE_BROWSER          = NO
INLINE_SOURCES          = NO
GENERATE_TREEVIEW       = YES
HAVE_DOT                = YES
DOT_IMAGE_FORMAT        = svg
# Диаграммы классов и связей
CLASS_GRAPH             = YES
COLLABORATION_GRAPH     = YES
GRAPHICAL_HIERARCHY     = YES

# Диаграммы зависимостей файлов
INCLUDE_GRAPH           = YES
INCLUDED_BY_GRAPH       = YES
DIRECTORY_GRAPH         = YES

# Не прятать содержимое диаграмм за динамическими секциями
HTML_DYNAMIC_SECTIONS   = NO